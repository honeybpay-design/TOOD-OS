{
  "version": "2.0.0",
  "tasks": [
    { "label": "Stack: up", "type": "shell", "command": "docker compose up -d --wait" },
    { "label": "Stack: down", "type": "shell", "command": "docker compose down" },
    { "label": "DB: migrate", "type": "shell", "command": "python scripts/migrate.py" },
    { "label": "Verify install", "type": "shell", "command": "python scripts/verify_install.py" },
    { "label": "API: run", "type": "shell", "command": "uvicorn app.main:app --reload --port 8000", "options": { "cwd": "${workspaceFolder}/apps/api" } },
    { "label": "Test: api", "type": "shell", "command": "pytest -q", "options": { "cwd": "${workspaceFolder}/apps/api" }, "group": "test" },
    { "label": "Gates: check evals", "type": "shell", "command": "python scripts/check_gates.py" }
  ]
}
